# pdf.xyz deployment BLUEPRINT — EXAMPLE env-file (names + placeholders only).
#
# The single `--env-file` for docker-compose.blueprint.yml. Copy to a git-ignored
# `.env` and replace every placeholder with a real value out-of-band. NEVER commit
# real secrets. Every value below is an obvious placeholder (REPLACE_*) or a
# LOCAL-ONLY internal address — not a credential. All variables are SERVER-SIDE ONLY
# and must NOT be prefixed NEXT_PUBLIC_ (that prefix would expose them to the browser).
#
#   cp docs/examples/deployment/.env.blueprint.example .env   # .env is git-ignored
#
# The `web` service needs NONE of these — it serves the site and takes no provider
# secret. Everything below configures the out-of-band `worker` (and the optional,
# profile-gated broker/scanner). With the two providers unset the daemon exits "not
# configured" (code 2) instead of processing.

# ---- Object storage: S3/R2-compatible (worker only; required to drain jobs) -------
PDFXYZ_STORAGE_PROVIDER=s3
PDFXYZ_S3_ENDPOINT=https://REPLACE-ME.example-object-storage.invalid
PDFXYZ_S3_REGION=auto
PDFXYZ_S3_BUCKET=replace-me-private-bucket
PDFXYZ_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
PDFXYZ_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY

# ---- Job queue: Redis/Upstash REST-compatible (worker only; required to drain) ----
PDFXYZ_QUEUE_PROVIDER=redis
# PRODUCTION: point this at your managed Redis-REST endpoint (an HTTPS URL), provisioned
# out-of-band, and DO NOT enable the `local-broker` compose profile.
# PDFXYZ_REDIS_REST_URL=https://REPLACE-ME.example-redis.invalid
# PDFXYZ_REDIS_REST_TOKEN=REPLACE_WITH_REDIS_REST_TOKEN
#
# LOCAL-ONLY (with `--profile local-broker`): the in-network shim serves the Redis
# REST dialect at http://broker:80 and authenticates the bearer token below. This is
# a development convenience on a private container network — NOT a production broker.
PDFXYZ_REDIS_REST_URL=http://broker:80
PDFXYZ_REDIS_REST_TOKEN=REPLACE_WITH_LOCAL_DEV_TOKEN

# ---- Optional malware scanner: ClamAV/clamd (worker only; OFF unless set) ----------
# With `--profile scanner` the worker streams inputs to the in-network clamd over
# INSTREAM. Unset ⇒ scanning is disabled and nothing is ever reported as scanned.
# Value form: clamav://<host>[:<port>] (default 3310) or clamav+unix://<socket-path>.
PDFXYZ_MALWARE_SCANNER=clamav://clamav:3310
# Make a clean scan mandatory (fail closed if the scanner is unavailable):
# PDFXYZ_WORKER_REQUIRE_SCAN=true

# ---- Optional worker liveness heartbeat (Phase 30; OFF by default) -----------------
# When enabled AND the Redis-REST broker above is configured, the daemon publishes a
# bounded, content-free heartbeat. /api/worker/operations reports daemonObserved=true
# only while the beat is fresh; stale/absent/disabled beats never fake liveness.
# PDFXYZ_WORKER_HEARTBEAT=true
# PDFXYZ_WORKER_HEARTBEAT_INTERVAL_SECONDS=15

# ---- Native deep compression (worker only; optional; lossless always works) --------
# auto (default) detects Ghostscript/qpdf/mutool on PATH; off disables the deep path.
PDFXYZ_NATIVE_COMPRESSION=auto
