{
  "name": "pdf-xyz",
  "version": "0.1.0",
  "private": true,
  "description": "pdf.xyz — a modern, fast, privacy-first PDF platform.",
  "scripts": {
    "dev": "tsx scripts/copy-pdfjs-wasm.ts && tsx scripts/copy-noto-fonts.ts && next dev",
    "build": "tsx scripts/copy-pdfjs-wasm.ts && tsx scripts/copy-noto-fonts.ts && next build --webpack",
    "start": "next start",
    "worker:daemon": "tsx scripts/worker-daemon.ts",
    "worker:daemon:status": "tsx scripts/worker-daemon.ts --dry-run-status",
    "verify:rate-limit": "tsx scripts/verify-rate-limit.ts",
    "interest:report": "tsx scripts/tool-interest-report.ts",
    "weigh:pages": "tsx scripts/weigh-pages.ts",
    "verify:upload-length": "tsx scripts/verify-upload-length-binding.ts",
    "a11y:contrast": "tsx scripts/a11y-contrast-audit.ts",
    "worker:prove-tools": "tsx scripts/worker-prove-tools.ts",
    "worker:ops-check": "tsx scripts/worker-ops-check.ts",
    "worker:cleanup-check": "tsx scripts/worker-cleanup-check.ts",
    "worker:artifact-cleanup": "tsx scripts/worker-artifact-cleanup.ts",
    "worker:cleanup-project": "tsx scripts/worker-cleanup-project.ts",
    "worker:cleanup-pipeline": "tsx scripts/worker-cleanup-pipeline.ts",
    "worker:ops-bundle": "tsx scripts/worker-ops-bundle.ts",
    "worker:release-gate": "tsx scripts/worker-release-gate.ts",
    "deploy:examples:check": "tsx scripts/validate-deployment-examples.ts",
    "worker:smoke": "sh scripts/worker-smoke.sh",
    "worker:engines": "sh scripts/worker-engines.sh",
    "worker:image-smoke": "sh scripts/worker-image-smoke.sh",
    "worker:ocr-proof": "sh scripts/worker-ocr-proof.sh",
    "worker:ocrmypdf-proof": "sh scripts/worker-ocrmypdf-proof.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/deploy/bundle-budget.test.ts'",
    "test:bundle": "vitest run src/deploy/bundle-budget.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "qa": "tsx scripts/qa.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pdfjs:wasm": "tsx scripts/copy-pdfjs-wasm.ts",
    "fonts:copy": "tsx scripts/copy-noto-fonts.ts",
    "fonts:coverage": "tsx scripts/generate-font-coverage.ts"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fontkit": "^2.0.4",
    "geist": "^1.7.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.22.0",
    "next": "^16.2.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo-google-fonts/noto-sans-jp": "^0.4.3",
    "@expo-google-fonts/noto-sans-kr": "^0.4.3",
    "@expo-google-fonts/noto-sans-sc": "^0.4.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9"
  }
}
