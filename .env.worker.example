# pdf.xyz secure-worker — EXAMPLE environment (names + placeholders only).
#
# Copy to a git-ignored `.env` and replace every placeholder with a real value
# out-of-band. NEVER commit real secrets. Every value below is an obvious
# placeholder (REPLACE_*), not a credential. All variables are SERVER-SIDE ONLY
# and must NOT be prefixed NEXT_PUBLIC_ (that prefix would expose them to the
# browser).
#
#   cp .env.worker.example .env      # .env is git-ignored
#
# The daemon validates presence/shape only and never logs a value. With the two
# providers unset it exits "not configured" (code 2) instead of processing.

# ---- Object storage: S3/R2-compatible (required to drain jobs) --------------
PDFXYZ_STORAGE_PROVIDER=s3
PDFXYZ_S3_ENDPOINT=https://REPLACE-ME.example-object-storage.invalid
PDFXYZ_S3_REGION=auto
PDFXYZ_S3_BUCKET=replace-me-private-bucket
PDFXYZ_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
PDFXYZ_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_ACCESS_KEY
# Optional:
# PDFXYZ_S3_SESSION_TOKEN=REPLACE_WITH_SESSION_TOKEN
# PDFXYZ_S3_FORCE_PATH_STYLE=false
# PDFXYZ_S3_KEY_PREFIX=
# PDFXYZ_S3_UPLOAD_TTL_SECONDS=900
# PDFXYZ_S3_DOWNLOAD_TTL_SECONDS=900
#
# Phase 39 (storage-backed artifact retrieval) adds NO new variables: the web app
# reads a completed job's artifact bytes from this same bucket SERVER-SIDE (a short,
# internal signed GET) and streams them through its guarded download route
# (`GET /api/artifacts/:artifactId`) — the client never receives a signed object-store
# URL. `PDFXYZ_S3_DOWNLOAD_TTL_SECONDS` therefore governs only the (still-available)
# signed-download reservation seam, not the client's artifact download, which is served
# by this app and lives for the artifact's retention window. Uploads are unchanged:
# the browser still PUTs directly to the bucket via a signed, expiring URL.
#
# Phase 41 (storage-backed lifecycle/expiry enforcement) also adds NO new variables: the
# worker signs the artifact's retention window (the SAME instant the client already holds
# as its download record's expiry) as content-free object metadata on the PUT, and the
# guarded download route denies a logically-expired or tombstoned object 410 Gone at
# retrieval time — BEFORE the bucket lifecycle rule physically reaps it. That app-level
# enforcement is additional to, not a replacement for, the bucket lifecycle-deletion rule
# you configure with `--lifecycle-policy` (see docs/RUNBOOK.md), which stays the deletion
# backstop; the retention window itself is the built-in default, not an env knob here.

# ---- Job queue: Redis/Upstash-compatible (required to drain jobs) -----------
PDFXYZ_QUEUE_PROVIDER=redis
PDFXYZ_REDIS_REST_URL=https://REPLACE-ME.example-redis.invalid
PDFXYZ_REDIS_REST_TOKEN=REPLACE_WITH_REDIS_REST_TOKEN
# Optional:
# PDFXYZ_QUEUE_KEY_PREFIX=pdfxyz
# PDFXYZ_QUEUE_LEASE_SECONDS=300
# PDFXYZ_QUEUE_MAX_ATTEMPTS=5
# PDFXYZ_QUEUE_JOB_TTL_SECONDS=86400

# ---- Worker liveness heartbeat (optional; OFF by default) -------------------
# When explicitly enabled and the Redis/Upstash queue broker above is configured,
# the daemon publishes a bounded, content-free heartbeat. /api/worker/operations
# reports daemonObserved=true only while the beat is fresh. Disabled/stale/absent
# heartbeats never fake liveness; confirm workers out-of-band when disabled.
# PDFXYZ_WORKER_HEARTBEAT=true
# PDFXYZ_WORKER_HEARTBEAT_INTERVAL_SECONDS=15

# ---- Native deep compression (optional; lossless repack always works) -------
# auto (default) detects Ghostscript/qpdf/mutool on PATH; off disables the deep
# path; a name pins one engine. Binary overrides must be safe absolute paths.
# PDFXYZ_NATIVE_COMPRESSION=auto
# PDFXYZ_COMPRESSION_ENGINE=ghostscript
# PDFXYZ_COMPRESSION_TIMEOUT_MS=120000
# PDFXYZ_COMPRESSION_MAX_INPUT_BYTES=209715200
# PDFXYZ_COMPRESSION_MAX_OUTPUT_BYTES=209715200

# ---- OCR backend (optional; OFF by default) ---------------------------------
# OCR is opt-in: unset ⇒ disabled and `ocr-pdf` fails honestly as not_implemented.
# `on` enables it, but a supported engine must ALSO be installed on this worker
# image: OCRmyPDF (preferred; PDF → searchable PDF + text) or Tesseract (images),
# plus the language packs your allowlist advertises. Binary overrides must be safe
# absolute paths. Values are never logged. See docs/OCR_BACKEND.md.
# PDFXYZ_OCR=on
# PDFXYZ_OCR_ENGINE=ocrmypdf
# PDFXYZ_OCR_OCRMYPDF_BIN=/usr/bin/ocrmypdf
# PDFXYZ_OCR_TESSERACT_BIN=/usr/bin/tesseract
# PDFXYZ_OCR_TIMEOUT_MS=300000
# PDFXYZ_OCR_MAX_INPUT_BYTES=209715200
# PDFXYZ_OCR_MAX_OUTPUT_BYTES=524288000
# PDFXYZ_OCR_TMPDIR=/tmp
# Require a ready OCR engine (fail --check / startup with exit 4 otherwise):
# PDFXYZ_WORKER_REQUIRE_OCR=true

# Worker file-soundness/quarantine gate (Phase 36) — server/worker only.
# Defaults: enabled, PDF header required for PDF-expected inputs, content-type and
# declared-size checks on, EOF and hard max-bytes opt-in. Values are parsed strictly;
# malformed values fall back to safe defaults. This is a bounded preflight, not
# malware scanning, PDF sanitization, OCR validation, or repair.
# PDFXYZ_WORKER_SOUNDNESS=on
# PDFXYZ_WORKER_SOUNDNESS_MAX_BYTES=0
# PDFXYZ_WORKER_SOUNDNESS_MAX_INPUTS=20
# PDFXYZ_WORKER_SOUNDNESS_REQUIRE_PDF_HEADER=true
# PDFXYZ_WORKER_SOUNDNESS_REQUIRE_PDF_EOF=false
# PDFXYZ_WORKER_SOUNDNESS_CHECK_CONTENT_TYPE=true
# PDFXYZ_WORKER_SOUNDNESS_CHECK_SIZE=true
# PDFXYZ_WORKER_SOUNDNESS_HEADER_SCAN_BYTES=1024
# PDFXYZ_WORKER_SOUNDNESS_TRAILER_SCAN_BYTES=1024

# Worker artifact-manifest / provenance gate (Phase 37) — server/worker only.
# After a processor produces its outputs and BEFORE any bytes are persisted or a
# download is minted, the worker validates each output's structural provenance:
# a non-empty output within the count/size ceilings, a recognized output kind whose
# content-type coheres with its filename extension and is one the tool may produce,
# and a resolvable retention/lifecycle class. Defaults: enabled, content-type and
# retention checks on, per-output byte ceiling opt-in. Values are parsed strictly;
# malformed values fall back to safe defaults. This is structural metadata validation
# only — not malware scanning, PDF sanitization, OCR-correctness, or a deletion proof.
# PDFXYZ_WORKER_ARTIFACT_MANIFEST=on
# PDFXYZ_WORKER_ARTIFACT_MAX_COUNT=64
# PDFXYZ_WORKER_ARTIFACT_MAX_BYTES=0
# PDFXYZ_WORKER_ARTIFACT_CHECK_CONTENT_TYPE=true
# PDFXYZ_WORKER_ARTIFACT_REQUIRE_RETENTION_CLASS=true
