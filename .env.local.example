# pdf.xyz — local development environment example
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# NEVER commit real values. Every value below is a placeholder.
#
# This file covers the web app + AI provider settings.
# For the secure worker's own configuration, see `.env.worker.example`
# (queue, S3/R2 storage, OCR engine, compression, soundness, artifact limits).
#
# ---------------------------------------------------------------------------
# Nothing here is required to run `pnpm dev`, `pnpm build`, `pnpm typecheck`,
# `pnpm lint`, or `pnpm test`. The app is designed to degrade honestly: an
# unconfigured provider reports `not_configured` / `not_implemented` instead of
# faking output. Only set these when you want a subsystem to actually run.
# ---------------------------------------------------------------------------


# === AI provider (summarize-pdf, translate-pdf, ai-extract, chat-with-pdf) ===
# With none of these set, all four AI tools report not-configured and fail
# honestly. That is the intended default for local development.
PDFXYZ_AI_PROVIDER=[REDACTED]
PDFXYZ_AI_API_KEY=[REDACTED]
PDFXYZ_AI_MODEL=[REDACTED]
PDFXYZ_AI_BASE_URL=[REDACTED]
PDFXYZ_AI_MAX_OUTPUT_TOKENS=[REDACTED]
PDFXYZ_AI_TIMEOUT_MS=[REDACTED]


# === Object storage (S3 / Cloudflare R2) ===
# Server-side only. Without these the worker has nowhere to read inputs from or
# write artifacts to, and reports storage as not-configured.
PDFXYZ_STORAGE_PROVIDER=[REDACTED]
PDFXYZ_S3_ENDPOINT=[REDACTED]
PDFXYZ_S3_REGION=[REDACTED]
PDFXYZ_S3_BUCKET=[REDACTED]
PDFXYZ_S3_ACCESS_KEY_ID=[REDACTED]
PDFXYZ_S3_SECRET_ACCESS_KEY=[REDACTED]


# === Job queue (Upstash Redis REST) ===
# Server-side only. Without these the queue is not drainable.
PDFXYZ_QUEUE_PROVIDER=[REDACTED]
PDFXYZ_REDIS_REST_URL=[REDACTED]
PDFXYZ_REDIS_REST_TOKEN=[REDACTED]


# === Retention / lifecycle backstop ===
# The app actively deletes inputs and expires artifacts on its own. These
# declare the bucket-level backstop so the daemon can verify it rather than
# report it as unknown. The worker daemon refuses to start if a lifecycle
# provider is declared without being marked validated.
PDFXYZ_LIFECYCLE_PROVIDER=[REDACTED]
PDFXYZ_LIFECYCLE_VALIDATED=[REDACTED]
PDFXYZ_LIFECYCLE_VERSIONED=[REDACTED]


# === Optional hardening / guardrails ===
# Malware scanning is off unless configured; uploads are never reported as
# scanned when it is not running.
PDFXYZ_MALWARE_SCANNER=[REDACTED]
PDFXYZ_RATE_LIMIT_FAIL_MODE=[REDACTED]

# Make the daemon refuse to start unless a capability is genuinely present.
# Useful in production, usually left unset locally.
PDFXYZ_WORKER_REQUIRE_DRAINABLE=[REDACTED]
PDFXYZ_WORKER_REQUIRE_LIFECYCLE=[REDACTED]
PDFXYZ_WORKER_REQUIRE_OCR=[REDACTED]
PDFXYZ_WORKER_REQUIRE_SCAN=[REDACTED]


# === Client-side telemetry (NEXT_PUBLIC_* is exposed to the browser) ===
# Never put a secret behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_TELEMETRY_ENDPOINT=[REDACTED]
NEXT_PUBLIC_TELEMETRY_SAMPLE_RATE=[REDACTED]
